        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%82%bb%e3%82%ad%e3%83%a5%e3%83%aa%e3%83%86%e3%82%a3%e3%81%8a%e3%82%88%e3%81%b3%e3%82%a2%e3%82%af%e3%82%bb%e3%82%b9%e7%ae%a1%e7%90%86%e3%81%ae%e9%9d%a9%e6%96%b0%e7%9a%84%e3%81%aa%e5%bf%9c%e7%94%a8%e5%88%86%e9%87%8e&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
