        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#chiyu-technology%e3%81%a8%e3%81%ae%e9%80%a3%e6%90%ba%e5%b0%82%e9%96%80%e7%9f%a5%e8%ad%98%e3%81%a8%e3%82%b5%e3%83%9d%e3%83%bc%e3%83%88&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
