        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%eb%8b%a4%ec%9a%a9%eb%8f%84-%ec%95%a1%ec%84%b8%ec%84%9c%eb%a6%ac%eb%a1%9c-%ec%b6%9c%ec%9e%85-%ed%86%b5%ec%a0%9c-%ec%8b%9c%ec%8a%a4%ed%85%9c-%ea%b0%95%ed%99%94&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
