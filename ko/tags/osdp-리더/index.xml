        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%98%84%eb%8c%80-%eb%b3%b4%ec%95%88%ec%9d%84-%ec%9c%84%ed%95%9c-%ea%b3%a0%ea%b8%89-%ec%b6%9c%ec%9e%85-%ed%86%b5%ec%a0%9c-%eb%a6%ac%eb%8d%94-%ec%86%94%eb%a3%a8%ec%85%98&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
