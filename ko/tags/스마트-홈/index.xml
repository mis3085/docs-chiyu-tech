        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%eb%b3%b4%ec%95%88-%eb%b0%8f-%ec%b6%9c%ec%9e%85-%ea%b4%80%eb%a6%ac%ec%9d%98-%ed%98%81%ec%8b%a0%ec%a0%81%ec%9d%b8-%ec%9d%91%ec%9a%a9-%eb%b6%84%ec%95%bc&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
